generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aquariums Aquarium[]
  fish      Fish[]

  sessions Session[]
  accounts Account[]
}

model Aquarium {
  id         String   @id @default(cuid())
  name       String   @default("My Aquarium")
  ownerId    String
  themeId    String?
  appearance Json     @default("{}")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fish  Fish[]

  @@index([ownerId])
}

model Fish {
  id            String   @id @default(cuid())
  name          String
  species       String   @default("classic")
  bodyColor     String   @default("#4F9CF9")
  finColor      String   @default("#3B82F6")
  paintKey      String?
  headDirection String?
  size          Float    @default(1)
  ownerId       String
  aquariumId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  aquarium Aquarium? @relation(fields: [aquariumId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([aquariumId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model TvPairingSession {
  id               String    @id @default(cuid())
  codeHash         String    @unique
  status           String    @default("pending")
  aquariumId       String?
  approvedByUserId String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  approvedAt       DateTime?
  consumedAt       DateTime?

  @@index([expiresAt])
  @@index([status])
}

model TvDisplaySession {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  aquariumId String
  ownerId    String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?
  lastSeenAt DateTime?
  pausedAt   DateTime?

  @@index([aquariumId])
  @@index([ownerId])
  @@index([expiresAt])
}

enum ContentType {
  THEME
  FISH_SPECIES
  DECORATION
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ContentItem {
  id                 String        @id @default(cuid())
  type               ContentType
  slug               String
  name               String
  status             ContentStatus @default(DRAFT)
  publishedVersionId String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  versions ContentVersion[]

  @@unique([type, slug])
  @@index([type, status])
}

model ContentVersion {
  id            String   @id @default(cuid())
  contentItemId String
  version       Int
  schemaVersion Int      @default(1)
  definition    Json
  createdAt     DateTime @default(now())

  contentItem ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([contentItemId, version])
}
